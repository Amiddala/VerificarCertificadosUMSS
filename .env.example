# PostgreSQL de solo lectura.
# Ejemplo: postgresql://verificacion_ro:CLAVE@HOST:5432/BASE?sslmode=require
DATABASE_URL=

# true: usa certificados de ejemplo en memoria, sin tocar PostgreSQL.
# Si DATABASE_URL está vacío, la API también usa mock automáticamente.
USE_MOCK=true

# SSL de la conexión a PostgreSQL. En local sin SSL, usar DATABASE_SSL=false.
DATABASE_SSL=true
# Si el proveedor usa una cadena de certificados que Node no reconoce,
# se puede desactivar la verificación (menos seguro):
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Solo lo usa `npm run qr`. No se expone al navegador.
BASE_URL=https://TU-DOMINIO.vercel.app
